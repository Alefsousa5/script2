        echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
        fun_xraymanager
    }

    #====================================================
    #  MOSTRAR USUARIOS REGISTRADOS
    #====================================================
    mosusr_xr () {
        clear
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\E[44;1;37m            USUARIOS REGISTRADOS | UUID XRAY             \E[0m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        VPSsec=$(date +%s)
        local HOST="${USRdatabase}"
        local RETURN="$(cat $HOST 2>/dev/null | cut -d'|' -f2)"
        local IDEUUID="$(cat $HOST 2>/dev/null | cut -d'|' -f1)"
        if [[ -z $RETURN ]]; then
            echo -e "----- NENHUM USUARIO REGISTRADO -----"
            echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
            fun_xraymanager
        else
            i=1
            echo -e "\e[97m                 UUID                | USER | EXPIRACAO \e[93m"
            echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
            while read hostreturn ; do
                [[ -z "$hostreturn" ]] && continue
                DateExp="$(cat ${USRdatabase} | grep -w "$hostreturn" | cut -d'|' -f3)"
                if [[ ! -z $DateExp ]]; then
                    DataSec=$(date +%s --date="$DateExp" 2>/dev/null)
                    if [[ -n "$DataSec" ]]; then
                        [[ "$VPSsec" -gt "$DataSec" ]] && EXPTIME="\e[91m[EXPIRADO]\e[97m" || EXPTIME="\e[92m[$(($(($DataSec - $VPSsec)) / 86400))]\e[97m Dias"
                    else
                        EXPTIME="\e[91m[ S/R ]"
                    fi
                else
                    EXPTIME="\e[91m[ S/R ]"
                fi
                usris="$(cat ${USRdatabase} | grep -w "$hostreturn" | cut -d'|' -f2)"
                local contador_secuencial+="\e[93m$hostreturn \e[97m|\e[93m$usris\e[97m|\e[93m $EXPTIME \n"
                if [[ $i -gt 30 ]]; then
                    echo -e "$contador_secuencial"
                    unset contador_secuencial
                    unset i
                fi
                let i++
            done <<< "$IDEUUID"
            [[ ! -z $contador_secuencial ]] && {
                linesss=$(cat ${USRdatabase} | wc -l)
                echo -e "$contador_secuencial \n Numero de Registrados: $linesss"
            }
        fi
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
        fun_xraymanager
    }

    #====================================================
    #  INFORMACAO DA CONTA (LINKS DE COMPARTILHAMENTO)
    #====================================================
    infocuenta () {
        [[ ! -e "$XRAY_CONFIG" ]] && {
            echo -e "\n\033[1;31mXRAY NAO INSTALADO!\033[0m"
            sleep 2
            fun_xraymanager
        }
        clear
        echo -e "\E[44;1;37m            INFORMAÇÃO DE CONTA | XRAY             \E[0m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        IP=$(cat /etc/IP 2>/dev/null)
        [[ -z "$IP" ]] && IP=$(wget -qO- ipv4.icanhazip.com 2>/dev/null)
        PORT=$(jq -r '.inbounds[0].port' "$XRAY_CONFIG" 2>/dev/null)
        PROTO=$(jq -r '.inbounds[0].protocol' "$XRAY_CONFIG" 2>/dev/null)
        WSPATH=$(jq -r '.inbounds[0].streamSettings.wsSettings.path' "$XRAY_CONFIG" 2>/dev/null)
        WSPATH_ENC=$(echo "$WSPATH" | sed 's|/|%2F|g')
        echo -e "\033[1;37m IP/SERVIDOR: \033[1;32m$IP"
        echo -e "\033[1;37m PORTA: \033[1;32m$PORT"
        echo -e "\033[1;37m PROTOCOLO: \033[1;32m$(echo $PROTO | tr 'a-z' 'A-Z')"
        echo -e "\033[1;37m REDE: \033[1;32mWS (WebSocket)"
        echo -e "\033[1;37m CAMINHO: \033[1;32m$WSPATH"
        echo -e "\033[1;37m SEGURANÇA: \033[1;32mnone"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        if [[ ! -s ${USRdatabase} ]]; then
            echo -e "----- NENHUM USUARIO REGISTRADO -----"
        else
            echo -e "\e[97m             LINKS DE COMPARTILHAMENTO\e[0m"
            echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
            while read -r uline; do
                [[ -z "$uline" ]] && continue
                uuid=$(echo "$uline" | cut -d'|' -f1 | tr -d ' ')
                unick=$(echo "$uline" | cut -d'|' -f2 | tr -d ' ')
                [[ -z "$uuid" ]] && continue
                echo -e "\033[1;33m► USUARIO:\033[1;32m $unick\033[0m"
                if [[ "$PROTO" = "vmess" ]]; then
                    vjson="{\"v\":\"2\",\"ps\":\"$unick\",\"add\":\"$IP\",\"port\":\"$PORT\",\"id\":\"$uuid\",\"aid\":\"0\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"$IP\",\"path\":\"$WSPATH\",\"tls\":\"\"}"
                    echo -e "\033[1;37mvmess://$(echo -n "$vjson" | base64 -w 0)\033[0m"
                else
                    echo -e "\033[1;37mvless://${uuid}@${IP}:${PORT}?type=ws&security=none&path=${WSPATH_ENC}#${unick}\033[0m"
                fi
                echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
            done < ${USRdatabase}
        fi
        echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
        fun_xraymanager
    }

