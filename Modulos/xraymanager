            echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
            fun_xraymanager
        }
        jq --arg id "$uuidel" '.inbounds[0].settings.clients |= map(select(.id != $id))' "$XRAY_CONFIG" > /tmp/xray_del.json && mv /tmp/xray_del.json "$XRAY_CONFIG"
        sed -i "/${uuidel}/d" ${USRdatabase}
        xray_restart
        echo ""
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
