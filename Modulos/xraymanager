#!/bin/bash
#====================================================
#	GERENCIADOR XRAY - EDIT: @VSCONEXAO
#	XRAY-CORE (VLESS / VMESS) INTEGRADO AO SSHPLUS
#====================================================
cor1='\033[41;1;37m'
cor2='\033[44;1;37m'
scor='\033[0m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
SCOLOR='\033[0m'
msg01='\033[1;37m\033[1;33mUsuário Nulo\033[1;31m'
msg02='\033[1;37m\033[1;33mNome muito curto (MIN: 2 CARACTERES)\033[1;31m'
msg03='\033[1;37m\033[1;33mNome muito grande (MAX: 16 CARACTERES)\033[1;31m'
msg04='\033[1;37m\033[1;33mSenha Nula\033[1;31m'
msg05='\033[1;37m\033[1;33mSenha muito curta\033[1;31m'
msg06='\033[1;37m\033[1;33mSenha muito grande\033[1;31m'
msg07='\033[1;37m\033[1;33mDuração Nula\033[1;31m'
msg08='\033[1;37m\033[1;33mDuração invalida, utilize números\033[1;31m'
msg09='\033[1;37m\033[1;33mDuração máxima de um ano\033[1;31m'
msg11='\033[1;37m\033[1;33mLimite Nulo\033[1;31m'
msg12='\033[1;37m\033[1;33mLimite invalido, utilize números\033[1;31m'
msg13='\033[1;37m\033[1;33mLimite máximo de 999\033[1;31m'
msg14='\033[1;37m\033[1;33mUsuario já Existe\033[1;31m'
msg15='\033[1;37m\033[1;33m(Apenas números) GB = Min: 1gb Max: 1000gb\033[1;31m'
msg16='\033[1;37m\033[1;33m(Apenas números)\033[1;31m'
msg17='\033[1;37m\033[1;33m(Sem imformação - Para Cancelar Digite CRTL + C)\033[1;31m'
[[ $(awk -F" " '{print $2}' /usr/lib/licence) == "VSCONEXAO" ]] && {
    err_fun () {
        case $1 in
        1)echo -e "\033[1;31mUsuário Nulo\033[0m"; sleep 2s; tput cuu1; tput dl1; tput cuu1; tput dl1;;
        2)echo -e "\033[1;31mNome muito curto (MIN: 2 CARACTERES)\033[0m"; sleep 2s; tput cuu1; tput dl1; tput cuu1; tput dl1;;
        3)echo -e "\033[1;31mNome muito grande (MAX: 16 CARACTERES)\033[0m"; sleep 2s; tput cuu1; tput dl1; tput cuu1; tput dl1;;
        7)echo -e "\033[1;31mDuração Nula\033[0m"; sleep 2s; tput cuu1; tput dl1; tput cuu1; tput dl1;;
        8)echo -e "\033[1;31mDuração invalida, utilize números\033[0m"; sleep 2s; tput cuu1; tput dl1; tput cuu1; tput dl1;;
        9)echo -e "\033[1;31mDuração máxima de um ano\033[0m"; sleep 2s; tput cuu1; tput dl1; tput cuu1; tput dl1;;
        14)echo -e "\033[1;31mUsuario já Existe\033[0m"; sleep 2s; tput cuu1; tput dl1; tput cuu1; tput dl1;;
        16)echo -e "\033[1;31m(Apenas números)\033[0m"; sleep 2s; tput cuu1; tput dl1; tput cuu1; tput dl1;;
        17)echo -e "\033[1;31m(Sem imformação - Para Cancelar Digite CRTL + C)\033[0m"; sleep 2s; tput cuu1; tput dl1; tput cuu1; tput dl1;;
        esac
    }

    #====================================================
    #  CONFIG / PATHS
    #====================================================
    XRAY_BIN="/usr/local/bin/xray"
    XRAY_CONFIG="/usr/local/etc/xray/config.json"
    USRdatabase="/etc/SSHPlus/RegXray"
    XRAY_DIR="/etc/SSHPlus/xray"

    #====================================================
    #  UTILITARIOS
    #====================================================
    port_in_use () {
        netstat -tunlp 2>/dev/null | awk -v p=":$1$" '$4 ~ p {found=1} END {exit !found}'
    }
    port_owner () {
        netstat -tunlp 2>/dev/null | awk -v p=":$1$" '$4 ~ p {print $7}' | head -1
    }
    liberar_porta () {
        local _pid=$(netstat -tunlp 2>/dev/null | awk -v p=":$1$" '$4 ~ p {print $7}' | head -1 | cut -d'/' -f1)
        [[ -n "$_pid" ]] && kill "$_pid" > /dev/null 2>&1 && sleep 2
    }
    xray_service_fix () {
        [[ $(id -u) != '0' ]] && return 0
        [[ ! -d /etc/systemd/system/xray.service.d ]] && mkdir -p /etc/systemd/system/xray.service.d
        cat > /etc/systemd/system/xray.service.d/10-bind.conf <<'EOF'
[Service]
User=root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
EOF
        systemctl daemon-reload > /dev/null 2>&1
    }
    xray_check_error () {
        echo -e "\033[1;31m ULTIMAS LINHAS DO LOG (diagnostico):\033[0m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        journalctl -u xray -n 12 --no-pager 2>/dev/null | tail -12
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    }
    xray_restart () {
        systemctl restart xray > /dev/null 2>&1 || service xray restart > /dev/null 2>&1
    }
    xray_stop () {
        systemctl stop xray > /dev/null 2>&1 || service xray stop > /dev/null 2>&1
    }
    xray_online () {
        if netstat -tunlp 2>/dev/null | grep -w xray 1> /dev/null 2> /dev/null; then
            return 0
        elif [[ $(ps x | grep -w 'xray run' | grep -v grep | wc -l) != '0' ]]; then
            return 0
        fi
        return 1
    }
    mk_base_config () {
        local _port="$1"
        local _proto="${2:-vless}"
        local _path="${3:-/sshplusxray}"
        [[ ! -d /usr/local/etc/xray ]] && mkdir -p /usr/local/etc/xray
        if [[ "$_proto" = "vmess" ]]; then
            local _settings='"settings": { "clients": [] }'
        else
            local _settings='"settings": { "decryption": "none", "clients": [] }'
        fi
        cat > "$XRAY_CONFIG" <<EOF
{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "inbound-sshplus",
      "listen": "0.0.0.0",
      "port": ${_port},
      "protocol": "${_proto}",
      ${_settings},
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": { "path": "${_path}" }
      }
    }
  ],
  "outbounds": [ { "protocol": "freedom", "tag": "direct" } ]
}
EOF
    }
    mk_limxray_script () {
        [[ ! -d "$XRAY_DIR" ]] && mkdir -p "$XRAY_DIR"
        cat > "$XRAY_DIR/limxray.sh" <<'LIMEOF'
#!/bin/bash
# LIMPADOR DE UUIDs EXPIRADOS - XRAY (SSHPLUS)
XRAY_CONFIG="/usr/local/etc/xray/config.json"
USRdatabase="/etc/SSHPlus/RegXray"
while true; do
    [[ -e "$USRdatabase" && -e "$XRAY_CONFIG" ]] && {
        VPSsec=$(date +%s)
        while read -r line; do
            [[ -z "$line" ]] && continue
            uuid=$(echo "$line" | cut -d'|' -f1 | tr -d ' ')
            DateExp=$(echo "$line" | cut -d'|' -f3 | tr -d ' ')
            [[ -z "$DateExp" ]] && continue
            DataSec=$(date +%s --date="$DateExp" 2>/dev/null) || continue
            if [[ "$VPSsec" -gt "$DataSec" ]]; then
                jq --arg id "$uuid" '.inbounds[0].settings.clients |= map(select(.id != $id))' "$XRAY_CONFIG" > /tmp/xray_lim.json 2>/dev/null && mv /tmp/xray_lim.json "$XRAY_CONFIG"
                sed -i "/$uuid/d" "$USRdatabase"
                systemctl restart xray > /dev/null 2>&1 || service xray restart > /dev/null 2>&1
            fi
        done < "$USRdatabase"
    }
    sleep 21600
done
LIMEOF
        chmod +x "$XRAY_DIR/limxray.sh"
    }

    #====================================================
    #  INSTALADOR XRAY
    #====================================================
    intallxray () {
        clear
        if [[ -e "$XRAY_BIN" ]]; then
            echo -e "\E[44;1;37m            INSTALADOR XRAY             \E[0m"
            echo -e "\n${YELLOW}XRAY JÁ ESTÁ INSTALADO\nDESEJA REINSTALAR? ${SCOLOR}\n"
            read -p "$(echo -e "\033[1;32mREINSTALAR [S/N]: \033[1;37m")" -e -i n respdea
            [[ "$respdea" != @(s|S) ]] && fun_xraymanager
        fi
        clear
        echo -e "\E[44;1;37m            INSTALADOR XRAY             \E[0m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        while true; do
            echo -ne "\e[91m >> DIGITE UMA PORTA (PADRAO 80): \033[1;92m" && read -p "" -e -i 80 portxray
            [[ -z "$portxray" ]] && { err_fun 17 && continue; }
            [[ "$portxray" != +([0-9]) ]] && { err_fun 16 && continue; }
            [[ "$portxray" -gt "65535" ]] && { err_fun 16 && continue; }
            if port_in_use "$portxray"; then
                echo -e "\e[91m PORTA $portxray EM USO POR: \e[97m$(port_owner "$portxray")\e[91m"
                echo -ne "\e[91m >> LIBERAR A PORTA E CONTINUAR? [S/N]: \033[1;92m" && read -p "" -e -i s reslib
                if [[ "$reslib" = @(s|S) ]]; then
                    liberar_porta "$portxray"
                    port_in_use "$portxray" && { echo -e "\e[91m NAO FOI POSSIVEL LIBERAR A PORTA!"; sleep 2; continue; }
                else
                    continue
                fi
            fi
            break
        done
        while true; do
            echo -ne "\e[91m >> CAMINHO WS (PADRAO /sshplusxray): \033[1;92m" && read -p "" -e -i "/sshplusxray" pathxray
            [[ -z "$pathxray" ]] && { err_fun 17 && continue; }
            [[ "${pathxray:0:1}" != "/" ]] && pathxray="/$pathxray"
            break
        done
        while true; do
            echo -e "\e[91m >> PROTOCOLO:\033[1;92m "
            echo -e "\033[1;37m[1] VLESS  \033[1;37m[2] VMESS\033[0m"
            read -p "$(echo -ne "\e[91m >> SELECIONE: \033[1;92m")" -e -i 1 _protox
            case $_protox in
                1) protox="vless"; break;;
                2) protox="vmess"; break;;
                *) echo -e "\e[91m OPCAO INVALIDA!"; sleep 1;;
            esac
        done
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;32mINSTALANDO DEPENDENCIAS...\033[0m"
        apt-get update -y > /dev/null 2>&1
        apt-get install curl wget unzip jq socat -y > /dev/null 2>&1
        echo -e "\033[1;32mBAIXANDO E INSTALANDO XRAY-CORE...\033[0m"
        bash -c "$(curl -sL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install > /dev/null 2>&1
        if [[ ! -e "$XRAY_BIN" ]]; then
            echo -e "\n\033[1;31mFALHA NA INSTALACAO DO XRAY! VERIFIQUE SUA CONEXAO\033[0m"
            echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
            echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
            fun_xraymanager
        fi
        [[ ! -d "$XRAY_DIR" ]] && mkdir -p "$XRAY_DIR"
        [[ ! -e ${USRdatabase} ]] && touch ${USRdatabase}
        sort ${USRdatabase} | uniq > ${USRdatabase}tmp
        mv -f ${USRdatabase}tmp ${USRdatabase}
        mk_base_config "$portxray" "$protox" "$pathxray"
        mk_limxray_script
        xray_service_fix
        systemctl enable xray > /dev/null 2>&1
        xray_restart
        [[ -f "/usr/sbin/ufw" ]] && ufw allow $portxray/tcp > /dev/null 2>&1
        clear
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        if xray_online; then
            echo -e "\033[1;32m XRAY INSTALADO E ATIVADO COM SUCESSO!"
        else
            echo -e "\033[1;31m XRAY INSTALADO, MAS O SERVICO NAO SUBIU!"
            xray_check_error
        fi
        echo -e "\033[1;37m PROTOCOLO: \033[1;33m$(echo $protox | tr 'a-z' 'A-Z')"
        echo -e "\033[1;37m PORTA: \033[1;33m$portxray"
        echo -e "\033[1;37m CAMINHO: \033[1;33m$pathxray"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
        fun_xraymanager
    }

    #====================================================
    #  ALTERAR PROTOCOLO (VLESS <-> VMESS)
    #====================================================
    protocolxray () {
        [[ ! -e "$XRAY_CONFIG" ]] && {
            echo -e "\n\033[1;31mXRAY NAO INSTALADO!\033[0m"
            sleep 2
            fun_xraymanager
        }
        echo -e "\E[44;1;37m            ALTERAR PROTOCOLO XRAY             \E[0m"
        _atual=$(jq -r '.inbounds[0].protocol' "$XRAY_CONFIG" 2>/dev/null)
        echo -e "\033[1;37m• \033[1;33mPROTOCOLO ATUAL: \033[1;32m$(echo $_atual | tr 'a-z' 'A-Z')\033[1;31m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;37m[1] \033[1;33mVLESS\033[0m"
        echo -e "\033[1;37m[2] \033[1;33mVMESS\033[0m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        read -p "$(echo -ne "\033[1;32mQUAL PROTOCOLO DESEJA USAR \033[1;33m?\033[1;37m ")" _pp
        case $_pp in
            1)
                jq '.inbounds[0].protocol = "vless" | .inbounds[0].settings.decryption = "none" | (.inbounds[0].settings.clients[]? |= del(.alterId))' "$XRAY_CONFIG" > /tmp/xray_p.json && mv /tmp/xray_p.json "$XRAY_CONFIG"
                echo -e "\n\033[1;32mPROTOCOLO ALTERADO PARA VLESS!\033[0m"
                ;;
            2)
                jq '.inbounds[0].protocol = "vmess" | del(.inbounds[0].settings.decryption) | (.inbounds[0].settings.clients[]? |= del(.alterId))' "$XRAY_CONFIG" > /tmp/xray_p.json && mv /tmp/xray_p.json "$XRAY_CONFIG"
                echo -e "\n\033[1;32mPROTOCOLO ALTERADO PARA VMESS!\033[0m"
                ;;
            *)
                echo -e "\n\033[1;31mOPCAO INVALIDA!\033[0m"
                sleep 2
                fun_xraymanager
                ;;
        esac
        xray_restart
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
        fun_xraymanager
    }

    #====================================================
    #  ALTERAR PORTA
    #====================================================
    portx () {
        [[ ! -e "$XRAY_CONFIG" ]] && {
            echo -e "\n\033[1;31mXRAY NAO INSTALADO!\033[0m"
            sleep 2
            fun_xraymanager
        }
        echo -e "\E[44;1;37m            ALTERAR PORTA XRAY             \E[0m"
        _atual=$(jq -r '.inbounds[0].port' "$XRAY_CONFIG" 2>/dev/null)
        echo -e "\033[1;37m• \033[1;33mPORTA ATUAL: \033[1;32m$_atual\033[1;31m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        while true; do
            port_in_use 80 && _defport="$_atual" || _defport="80"
            echo -ne "\e[91m >> DIGITE A NOVA PORTA (PADRAO $_defport): \033[1;92m" && read -p "" -e -i "$_defport" portnew
            [[ -z "$portnew" ]] && { err_fun 17 && continue; }
            [[ "$portnew" != +([0-9]) ]] && { err_fun 16 && continue; }
            [[ "$portnew" -gt "65535" ]] && { err_fun 16 && continue; }
            if [[ "$portnew" != "$_atual" ]] && port_in_use "$portnew"; then
                echo -e "\e[91m PORTA $portnew EM USO POR: \e[97m$(port_owner "$portnew")\e[91m"
                echo -ne "\e[91m >> LIBERAR A PORTA E CONTINUAR? [S/N]: \033[1;92m" && read -p "" -e -i s reslib
                if [[ "$reslib" = @(s|S) ]]; then
                    liberar_porta "$portnew"
                    port_in_use "$portnew" && { echo -e "\e[91m NAO FOI POSSIVEL LIBERAR A PORTA!"; sleep 2; continue; }
                else
                    continue
                fi
            fi
            break
        done
        jq --argjson p "$portnew" '.inbounds[0].port = $p' "$XRAY_CONFIG" > /tmp/xray_port.json && mv /tmp/xray_port.json "$XRAY_CONFIG"
        [[ -f "/usr/sbin/ufw" ]] && ufw allow $portnew/tcp > /dev/null 2>&1
        xray_service_fix
        xray_restart
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        if xray_online; then
            echo -e "\033[1;32mPORTA ALTERADA PARA $portnew COM SUCESSO!\033[0m"
        else
            echo -e "\033[1;31mO SERVICO NAO SUBIU NA PORTA $portnew!\033[0m"
            xray_check_error
        fi
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
        fun_xraymanager
    }

    #====================================================
    #  ALTERAR CAMINHO WS
    #====================================================
    pathx () {
        [[ ! -e "$XRAY_CONFIG" ]] && {
            echo -e "\n\033[1;31mXRAY NAO INSTALADO!\033[0m"
            sleep 2
            fun_xraymanager
        }
        echo -e "\E[44;1;37m            ALTERAR CAMINHO WS XRAY             \E[0m"
        _atual=$(jq -r '.inbounds[0].streamSettings.wsSettings.path' "$XRAY_CONFIG" 2>/dev/null)
        echo -e "\033[1;37m• \033[1;33mCAMINHO ATUAL: \033[1;32m$_atual\033[1;31m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        while true; do
            echo -ne "\e[91m >> DIGITE O NOVO CAMINHO: \033[1;92m" && read pathnew
            [[ -z "$pathnew" ]] && { err_fun 17 && continue; }
            [[ "${pathnew:0:1}" != "/" ]] && pathnew="/$pathnew"
            break
        done
        jq --arg pt "$pathnew" '.inbounds[0].streamSettings.wsSettings.path = $pt' "$XRAY_CONFIG" > /tmp/xray_ws.json && mv /tmp/xray_ws.json "$XRAY_CONFIG"
        xray_restart
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;32mCAMINHO ALTERADO PARA $pathnew COM SUCESSO!\033[0m"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
        fun_xraymanager
    }

    #====================================================
    #  ADICIONAR USUARIO UUID
    #====================================================
    addusr () {
        [[ ! -e "$XRAY_CONFIG" ]] && {
            echo -e "\n\033[1;31mXRAY NAO INSTALADO!\033[0m"
            sleep 2
            fun_xraymanager
        }
        clear
        echo -e "\E[44;1;37m            ADICIONAR USUARIO | UUID XRAY             \E[0m"
        UUID=$(cat /proc/sys/kernel/random/uuid)
        echo ""
        while true; do
            echo -ne "\e[91m >> Digite um usuário: \033[1;92m"
            read -p "" nick
            nick="$(echo $nick | sed -e 's/[^a-z0-9 -]//ig')"
            if [[ -z $nick ]]; then
                echo -e "$msg17" && continue
            elif [[ "${#nick}" -lt "2" ]]; then
                echo -e "$msg02" && continue
            elif [[ "${#nick}" -gt "16" ]]; then
                echo -e "$msg03" && continue
            fi
            break
        done
        echo -e "\e[91m >> Adicionar UUID: \e[92m$UUID "
        while true; do
            echo -ne "\e[91m >> Duração de UUID (Dias):\033[1;92m " && read diasuser
            if [[ -z "$diasuser" ]]; then
                echo -e "$msg17" && continue
            elif [[ "$diasuser" != +([0-9]) ]]; then
                echo -e "$msg08" && continue
            elif [[ "$diasuser" -gt "360" ]]; then
                echo -e "$msg09" && continue
            fi
            break
        done
        valid=$(date '+%C%y-%m-%d' -d " +$diasuser days") && datexp=$(date "+%F" -d " + $diasuser days")
        echo -e "\e[91m >> Expira em : \e[92m$datexp "
        jq --arg id "$UUID" --arg email "$nick@xray" '.inbounds[0].settings.clients += [{"id": $id, "email": $email}]' "$XRAY_CONFIG" > /tmp/xray_add.json && mv /tmp/xray_add.json "$XRAY_CONFIG"
        ##Registro
        echo "  $UUID | $nick | $valid " >> ${USRdatabase}
        Fecha=$(date +%d-%m-%y-%R)
        [[ -d "$XRAY_DIR" ]] && cp ${USRdatabase} $XRAY_DIR/RegXray-"$Fecha"
        xray_restart
        echo ""
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\e[92m           UUID ADICIONADO COM EXITO "
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
        fun_xraymanager
    }

