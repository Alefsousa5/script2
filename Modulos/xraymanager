            echo -e "----- NENHUM USUARIO REGISTRADO -----"
            echo -e "\033[1;37m• \033[1;33mEnter Para Continuar\033[1;31m" && read enter
            fun_xraymanager
        fi
        echo -e "\e[97m               USUARIOS REGISTRADOS"
        echo -e "\e[33m$(cat ${USRdatabase} | cut -d '|' -f2,1)"
        echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -ne "\e[91m >> Digite o NUMERO ou UUID para remover:\n \033[1;92m " && read uuidel
        [[ -z "$uuidel" ]] && {
            echo -e "$msg17"
            fun_xraymanager
        }
        if [[ "$uuidel" = +([0-9]) && "${#uuidel}" -le "3" ]]; then
            uuidel=$(sed -n "${uuidel}p" ${USRdatabase} | cut -d'|' -f1 | tr -d ' ')
        fi
