#====================================================
#  VERIFICACAO: LISTA USUARIOS EXPIRADOS
#====================================================
fun_expirados () {
clear
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\E[41;1;37m            USUARIOS E DATA DE EXPIRACAO             \E[0m"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
_datahj=$(date +%s)
_nexp=0
_ndisp=0
while IFS= read -r _user; do
    [[ -z "$_user" ]] && continue
    _exp=$(chage -l "$_user" 2>/dev/null | grep -i "Account expires" | cut -d: -f2- | sed 's/^ *//')
    [[ -z "$_exp" ]] && continue
    [[ "$_exp" == never* || "$_exp" == *nunca* ]] && continue
    _expsec=$(date +%s --date="$_exp" 2>/dev/null)
    [[ -z "$_expsec" ]] && continue
    if [[ "$_datahj" -ge "$_expsec" ]]; then
        echo -e "\033[1;31m► $_user \033[1;37m— EXPIRADO em \033[1;31m$(date -d @$_expsec +%d/%m/%Y)\033[0m"
        _nexp=$(($_nexp + 1))
    else
        echo -e "\033[1;37m► $_user \033[1;37m— expira em \033[1;32m$(date -d @$_expsec +%d/%m/%Y) \033[1;37m(\033[1;32m$((($_expsec - $_datahj) / 86400))\033[1;37m dias)\033[0m"
    fi
    _ndisp=$(($_ndisp + 1))
done <<< "$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody)"
[[ "$_ndisp" = '0' ]] && echo -e "\033[1;33mNENHUM USUARIO COM DATA DE EXPIRACAO\033[0m"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;33mTOTAL EXPIRADOS: \033[1;31m$_nexp\033[0m"
echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -ne "\n\033[1;31mENTER \033[1;33mpara retornar ao \033[1;32mMENU!\033[0m"; read
menu_verificacoes
}
